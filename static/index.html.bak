<!DOCTYPE html>

<html lang="en"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><meta content="web_standard" name="shell-type"/><title>Neural Topology Mapping • Crowd Surge &amp; Compression Mitigation</title><link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>@layer base { html, body { margin: 0; padding: 0; } body { overscroll-behavior: none; } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "error-container": "#ffdad6", "on-surface-variant": "#3f4850", "surface-tint": "#006398", "on-secondary": "#ffffff", "on-background": "#181c20", "outline": "#707881", "on-error-container": "#93000a", "background": "#f7f9ff", "on-primary-fixed": "#001d31", "secondary-fixed-dim": "#bcc7de", "on-tertiary": "#ffffff", "on-tertiary-fixed-variant": "#43474b", "surface-container-lowest": "#ffffff", "on-secondary-fixed-variant": "#3c475a", "surface-bright": "#f7f9ff", "tertiary-fixed-dim": "#c3c7cb", "outline-variant": "#bfc7d2", "primary-fixed": "#cce5ff", "on-error": "#ffffff", "surface-container-high": "#e5e8ee", "primary-container": "#007bb9", "tertiary": "#585d60", "surface-container": "#ebeef3", "on-primary-container": "#fdfcff", "on-tertiary-fixed": "#171c1f", "inverse-surface": "#2d3135", "on-surface": "#181c20", "inverse-primary": "#93ccff", "surface-container-low": "#f1f4f9", "surface-dim": "#d7dadf", "surface-variant": "#e0e3e8", "surface": "#f7f9ff", "secondary": "#545f73", "primary": "#006194", "surface-container-highest": "#e0e3e8", "on-primary-fixed-variant": "#004b73", "inverse-on-surface": "#eef1f6", "primary-fixed-dim": "#93ccff", "error": "#ba1a1a", "secondary-container": "#d5e0f8", "on-tertiary-container": "#fbfcff", "secondary-fixed": "#d8e3fb", "on-secondary-fixed": "#111c2d", "tertiary-fixed": "#dfe3e7", "tertiary-container": "#707579", "on-primary": "#ffffff", "on-secondary-container": "#586377" }, "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, "spacing": {}, "fontFamily": { "headline": ["Public Sans"], "display": ["Public Sans"], "body": ["Public Sans"], "label": ["Public Sans"] }, "fontSize": {} } } };</script></head><body class="bg-surface font-body text-on-surface antialiased"><header class="fixed top-0 left-0 right-0 z-50 bg-inverse-surface text-inverse-on-surface shadow-[0_1px_8px_rgba(0,0,0,0.06)]"><div class="bg-on-background/40 border-b border-outline-variant/20 px-6 py-1 text-xs text-surface-container-high"><div class="max-w-[1200px] mx-auto flex items-center justify-between"><div class="flex items-center gap-2"><span class="material-symbols-outlined text-[14px] text-surface-tint">policy</span><span class="font-label tracking-wide uppercase text-[11px]">Official Government System • Public Safety Optical Operations Division</span></div><div class="flex items-center gap-4 text-[11px] font-mono"><span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>SECURE NODE: OSN-EAST-04</span><span class="text-outline-variant">|</span><span>ENCRYPTION: FIPS 140-3</span></div></div></div><div class="h-20 max-w-[1200px] mx-auto px-6 flex items-center justify-between gap-6"><div class="flex items-center gap-4 shrink-0"><div class="w-10 h-10 bg-primary-container/30 border border-primary/40 flex items-center justify-center"><span class="material-symbols-outlined text-primary-fixed text-2xl">verified_user</span></div><div class="flex flex-col"><span class="text-xs font-label uppercase tracking-widest text-outline-variant">Municipal Command • Section 508</span><span class="font-headline text-base font-bold tracking-tight text-white">CIVIC SURVEILLANCE &amp; OPTICAL TELEMETRY</span></div></div><div class="flex items-center gap-5 shrink-0"><div class="flex flex-col items-end border-r border-outline-variant/30 pr-5"><span class="text-[11px] uppercase tracking-wider font-label text-outline-variant">Operator Clearance</span><span class="inline-flex items-center px-2 py-0.5 mt-0.5 text-xs font-semibold bg-surface-container-low text-on-surface border border-outline-variant">LEVEL IV - UNRESTRICTED</span></div><div class="flex flex-col items-end border-r border-outline-variant/30 pr-5 font-mono"><span class="text-[11px] uppercase tracking-wider font-label text-outline-variant">System Time (UTC)</span><span class="text-xs text-surface-bright font-semibold tracking-wide">14:28:02 Z • ACTIVE</span></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div><div class="bg-inverse-surface/95 border-t border-outline-variant/20 px-6"><div class="max-w-[1200px] mx-auto"><nav class="flex items-center gap-1 overflow-x-auto py-1" data-active-classes="bg-primary text-on-primary font-bold shadow-sm"><a class="px-3.5 py-2 text-xs font-semibold uppercase tracking-wider text-surface-container-high hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center gap-1.5 shrink-0" data-path="cctv-telemetry-feed-analysis" href="#">CCTV Telemetry &amp; Feed Analysis</a><a class="px-3.5 py-2 text-xs font-semibold uppercase tracking-wider text-surface-container-high hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center gap-2 shrink-0" data-path="topology-concourse-mesh" href="#">Topology &amp; Concourse Mesh<span class="text-[10px] px-1.5 py-0.2 bg-secondary-container text-on-secondary-container font-mono normal-case tracking-normal border border-outline-variant/40">Planned</span></a><a class="px-3.5 py-2 text-xs font-semibold uppercase tracking-wider text-surface-container-high hover:bg-surface-container-high hover:text-on-surface transition-colors shrink-0" data-path="early-warning-compression-alerts" href="#">Early Warning Compression Alerts</a><a class="px-3.5 py-2 text-xs font-semibold uppercase tracking-wider text-surface-container-high hover:bg-surface-container-high hover:text-on-surface transition-colors shrink-0" data-path="investigations-records" href="#">Investigations &amp; Records</a><a class="px-3.5 py-2 text-xs font-semibold uppercase tracking-wider text-surface-container-high hover:bg-surface-container-high hover:text-on-surface transition-colors shrink-0" data-path="system-compliance-audit" href="#">System Compliance &amp; Audit</a></nav></div></div></header><main class="w-full pt-36 bg-surface min-h-[calc(100vh-14rem)]"><div class="flex flex-col w-full">
<!-- Official Section Utility / Breadcrumb Sub-Header -->
<div class="w-full bg-surface-container-low border-b border-outline-variant/40 px-6 py-3">
<div class="max-w-[1200px] mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs">
<div class="flex items-center gap-2 text-on-surface-variant font-mono">
<span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-surface-container-lowest border border-outline-variant font-semibold text-primary">
<span class="w-2 h-2 rounded-none bg-emerald-600"></span>
          SYS.DIAG: ONLINE
        </span>
<span class="text-outline-variant">/</span>
<span>OPS-DIVISION: MUNICIPAL TRANSIT &amp; CIVIC PLAZAS</span>
<span class="text-outline-variant">/</span>
<span class="text-on-surface font-semibold">FEED-ANALYSIS-PORTAL-v4</span>
</div>
<div class="flex items-center gap-4 text-on-surface-variant font-mono text-[11px]">
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[15px] text-primary">dns</span>
          HOST: <code>EDGE-SRV-NORTH-04</code>
</span>
<span class="text-outline-variant">|</span>
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[15px] text-emerald-700">lock</span>
          PRIVACY ENCLAVE: ACTIVE
        </span>
</div>
</div>
</div>
<!-- Main Operational Canvas -->
<div class="w-full px-6 py-6 max-w-[1200px] mx-auto space-y-6">
<!-- Console Header & Live Telemetry Metadata Bar -->
<div class="bg-surface-container-lowest border border-outline-variant p-6 shadow-sm">
<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 pb-5 border-b border-outline-variant/40">
<div class="space-y-1">
<div class="flex items-center gap-2">
<span class="px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-inverse-surface text-inverse-on-surface">OPERATIONAL CONSOLE</span>
<span class="px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase bg-primary-fixed text-on-primary-fixed border border-primary/20">EDITION 2025.1</span>
</div>
<h1 class="text-2xl font-bold font-headline text-on-surface tracking-tight">Optical Telemetry &amp; Edge CCTV Analysis Console</h1>
<p class="text-sm text-on-surface-variant max-w-3xl leading-relaxed">
            Autonomous crowd flow monitoring, localized density calculation, and fall anomaly detection for public transit hubs and civic plazas under Statutory Surveillance Standard §14.2.
          </p>
</div>
<div class="flex items-center gap-2 shrink-0 self-start">
<button class="px-3.5 py-2 text-xs font-semibold bg-surface-container hover:bg-surface-container-high text-on-surface border border-outline-variant flex items-center gap-1.5 transition-colors focus:outline focus:outline-2 focus:outline-primary" id="systemRefreshBtn" onclick="window.flushPipeline &amp;&amp; window.flushPipeline()" type="button">
<span class="material-symbols-outlined text-sm">sync</span>
            Flush Pipeline
          </button>
<button class="px-3.5 py-2 text-xs font-semibold bg-inverse-surface hover:bg-black text-white flex items-center gap-1.5 transition-colors focus:outline focus:outline-2 focus:outline-primary" id="viewReferenceBtn" type="button">
<span class="material-symbols-outlined text-sm">description</span>
            Audit Directive
          </button>
</div>
</div>
<!-- Live Metadata Grid Bar -->
<div class="pt-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-mono">
<div class="border-l-2 border-primary pl-3 bg-surface-container-low/50 py-1.5">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider block font-sans font-semibold">Terminal Ingestion Node</span>
<span class="text-on-surface font-bold text-xs mt-0.5 flex items-center gap-1.5">
<span class="w-1.5 h-1.5 bg-primary"></span>
            NODE-04 / NORTH PLAZA CONCOURSE
          </span>
</div>
<div class="border-l-2 border-emerald-600 pl-3 bg-surface-container-low/50 py-1.5">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider block font-sans font-semibold">Inference Model Engine</span>
<span class="text-emerald-800 font-bold text-xs mt-0.5 flex items-center gap-1.5">
<span class="w-1.5 h-1.5 bg-emerald-600"></span>
            <span id="metaModelText">YOLOv8m Crowd Tracking</span>
          </span>
</div>
<div class="border-l-2 border-secondary pl-3 bg-surface-container-low/50 py-1.5">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider block font-sans font-semibold">Optical Feed Input</span>
<span class="text-on-surface font-semibold text-xs mt-0.5 flex items-center gap-1.5">
<span class="w-1.5 h-1.5 bg-secondary" id="metaInputDot"></span>
            <span id="metaInputText">Awaiting Frame Ingestion (Ready)</span>
          </span>
</div>
<div class="border-l-2 border-outline pl-3 bg-surface-container-low/50 py-1.5">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider block font-sans font-semibold">Compute Device / FPS</span>
<span class="text-on-surface font-semibold text-xs mt-0.5 flex items-center gap-1.5 truncate" id="metaDeviceText">
            Detecting hardware...
          </span>
</div>
</div>
</div>
<!-- Primary Operational Grid (65% / 35%) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
<!-- LEFT COLUMN: 65% width (8 Cols) - Monitor & Metrics -->
<div class="lg:col-span-8 space-y-6">
<!-- Video Feed Container / Dark Monitor Frame -->
<div class="bg-surface-container-lowest border border-outline-variant overflow-hidden shadow-sm">
<!-- Monitor Header Bar -->
<div class="bg-inverse-surface text-inverse-on-surface px-4 py-2.5 flex items-center justify-between border-b border-outline-variant/30 text-xs">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-none bg-error animate-pulse"></span>
<span class="font-bold tracking-wider font-mono text-[11px] uppercase text-white">OPTICAL MONITOR FEED // PRIMARY CANV-01</span>
<span class="text-outline-variant font-mono text-[10px]">[EDGE INGESTION ACTIVE]</span>
</div>
<div class="flex items-center gap-3 font-mono text-[11px]">
<span class="text-surface-dim flex items-center gap-1">
<span class="material-symbols-outlined text-[13px] text-outline-variant">grid_view</span>
                ASPECT 16:9
              </span>
<span class="text-outline-variant">|</span>
<span class="text-surface-bright flex items-center gap-1">
<span class="material-symbols-outlined text-[13px] text-emerald-400">sensors</span>
                FPS: 00.0
              </span>
</div>
</div>
<!-- Video Monitor Screen (Dark Room CRT / Institutional Look) -->
<div class="relative w-full aspect-video bg-[#0b1320] flex flex-col items-center justify-center p-6 select-none overflow-hidden group" id="monitorContainer">
<!-- Gridlines and reticle overlay -->
<div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(to_right,#334155_1px,transparent_1px),linear-gradient(to_bottom,#334155_1px,transparent_1px)] bg-[size:40px_40px]"></div>
<!-- Corner Reticles for camera framing -->
<div class="absolute top-4 left-4 w-5 h-5 border-t-2 border-l-2 border-outline-variant pointer-events-none"></div>
<div class="absolute top-4 right-4 w-5 h-5 border-t-2 border-r-2 border-outline-variant pointer-events-none"></div>
<div class="absolute bottom-4 left-4 w-5 h-5 border-b-2 border-l-2 border-outline-variant pointer-events-none"></div>
<div class="absolute bottom-4 right-4 w-5 h-5 border-b-2 border-r-2 border-outline-variant pointer-events-none"></div>
<!-- Optical Center Reticle Cross -->
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 pointer-events-none opacity-30 flex items-center justify-center">
<span class="w-full h-[1px] bg-white absolute"></span>
<span class="h-full w-[1px] bg-white absolute"></span>
</div>
<!-- Inactive Stream State Overlay -->
<div class="relative z-10 flex flex-col items-center text-center max-w-md px-4" id="noStreamState">
<div class="w-16 h-16 bg-surface-container/10 border border-outline-variant/40 flex items-center justify-center text-white mb-4">
<span class="material-symbols-outlined text-3xl text-outline-variant">videocam_off</span>
</div>
<h2 class="text-base font-bold font-headline text-white tracking-wide">No active video stream loaded</h2>
<p class="text-xs text-outline-variant mt-1.5 leading-relaxed">
                Upload an uncompressed CCTV recording (.mp4, .mov, .avi • max 100MB) or register an edge RTSP stream to begin optical spatial analysis.
              </p>
<!-- Quick Diagnostic Badge -->
<div class="mt-4 px-3 py-1 bg-black/50 border border-outline-variant/30 text-[10px] font-mono text-outline-variant flex items-center gap-2">
<span>PIPELINE BUFFER: 0 BYTES ALLOCATED</span>
<span>•</span>
<span>STATUS: IDLE</span>
</div>
</div>
<!-- Dynamic In-Monitor Processing Panel (Hidden by default) -->
<div id="processingPanel" class="relative z-30 flex flex-col items-center text-center max-w-md w-full px-6 py-6 bg-surface-container-lowest/95 border border-outline-variant shadow-2xl hidden">
  <div class="w-full flex items-center justify-between pb-3 border-b border-outline-variant/30 text-xs font-mono">
    <span class="font-bold text-on-surface flex items-center gap-2">
      <span class="w-2 h-2 rounded-none bg-primary animate-ping"></span>
      <span id="procStageBadge" class="uppercase">STAGE: UPLOADING</span>
    </span>
    <span class="px-2 py-0.5 text-[10px] font-bold bg-primary-fixed text-on-primary-fixed border border-primary/20" id="procStatusBadge">STATUS: PROCESSING</span>
  </div>
  <div class="w-full my-4 space-y-2">
    <div class="flex justify-between items-center text-xs font-mono">
      <span id="procMessage" class="text-on-surface font-semibold text-left truncate max-w-[260px]">Ingesting optical telemetry stream...</span>
      <span id="procPercent" class="font-bold text-primary text-sm">0%</span>
    </div>
    <div class="w-full h-2.5 bg-surface-container-high border border-outline-variant/50 overflow-hidden">
      <div id="procProgressBar" class="h-full bg-primary transition-all duration-200" style="width: 0%"></div>
    </div>
    <div class="flex justify-between text-[11px] font-mono text-on-surface-variant pt-1">
      <span id="procFrameText">FRAME: 0 / 0</span>
      <span id="procEtaText">ETA: --</span>
      <span id="procFpsText">FPS: --</span>
    </div>
  </div>
</div>

<!-- Dynamic In-Monitor Error Panel (Hidden by default) -->
<div id="errorPanel" class="relative z-30 flex flex-col items-center text-center max-w-md w-full px-6 py-6 bg-surface-container-lowest border-2 border-error shadow-2xl hidden">
  <div class="w-12 h-12 bg-error/10 border border-error/30 text-error flex items-center justify-center mb-3">
    <span class="material-symbols-outlined text-3xl">warning</span>
  </div>
  <h3 class="text-sm font-bold uppercase tracking-wider text-error font-headline" id="errorTitle">Telemetry Pipeline Anomaly</h3>
  <p class="text-xs text-on-surface-variant mt-2 mb-4 leading-relaxed font-mono" id="errorMessage">An unexpected anomaly interrupted the pipeline.</p>
  <button id="errorRetryBtn" type="button" class="px-4 py-2 bg-error hover:bg-red-800 text-white font-label text-xs font-bold tracking-wider uppercase transition-colors border border-red-900 focus:outline focus:outline-2 focus:outline-error">
    Dismiss &amp; Retry
  </button>
</div>

<!-- Live Loaded Stream with Native Video Player -->
<div class="absolute inset-0 hidden z-10" id="activeStreamState">
  <video id="resultVideo" controls playsinline class="w-full h-full object-contain bg-black"></video>
  <div id="videoOverlayBadge" class="absolute top-3 left-3 bg-black/85 text-white font-mono text-[10px] px-2 py-1 border border-outline-variant flex items-center gap-2 pointer-events-none z-10">
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span id="activeStreamLabel">CCTV TELEMETRY: PROCESSED FEED</span>
    <span class="text-outline-variant">|</span>
    <span id="cachedResultTag" class="hidden text-amber-300 font-bold bg-amber-950/80 px-1 border border-amber-600/50">CACHED RESULT (SHA-256)</span>
  </div>
</div>
<!-- Bottom Video Player Controls Bar (Simulated - shown only on idle) -->
<div class="absolute bottom-0 left-0 right-0 h-10 bg-black/85 backdrop-blur-sm border-t border-outline-variant/30 px-4 flex items-center justify-between text-xs text-outline-variant z-20" id="simulatedControlsBar">
<div class="flex items-center gap-3">
<button class="hover:text-white transition-colors flex items-center justify-center" type="button">
<span class="material-symbols-outlined text-base">play_arrow</span>
</button>
<button class="hover:text-white transition-colors flex items-center justify-center" type="button">
<span class="material-symbols-outlined text-base">stop</span>
</button>
<div class="h-3 w-[1px] bg-outline-variant/40"></div>
<span class="font-mono text-[10px] text-surface-bright">00:00:00 / --:--:--</span>
</div>
<div class="flex items-center gap-3 font-mono text-[11px]">
<button class="hover:text-white transition-colors" title="Toggle Privacy Bounding Boxes" type="button">
<span class="material-symbols-outlined text-sm">visibility</span>
</button>
<button class="hover:text-white transition-colors" title="Snapshot Frame" type="button">
<span class="material-symbols-outlined text-sm">photo_camera</span>
</button>
<button class="hover:text-white transition-colors" title="Toggle Fullscreen" type="button">
<span class="material-symbols-outlined text-sm">fullscreen</span>
</button>
</div>
</div>
</div>
<!-- Video File Ingestion Controls & Demonstration Trigger -->
<div class="p-4 bg-surface-container-low border-t border-outline-variant/40">
<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
<div class="flex items-center gap-2">
<label class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-primary hover:bg-primary-container text-on-primary font-label text-xs font-bold tracking-wider uppercase transition-colors border border-primary" for="cctvFileInput">
<span class="material-symbols-outlined text-sm">file_upload</span>
                  Select Video File
                </label>
<input accept=".mp4,.mov,.avi" class="sr-only" id="cctvFileInput" type="file"/>
<button class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label text-xs font-semibold tracking-wide border border-outline-variant transition-colors" id="loadSampleFeedBtn" onclick="window.loadSampleFeed &amp;&amp; window.loadSampleFeed()" type="button">
<span class="material-symbols-outlined text-sm text-primary">play_circle</span>
                  Load Demonstration Test Sample Feed
                </button>
</div>
<div class="flex items-center gap-2 text-xs text-on-surface-variant font-mono">
<span class="material-symbols-outlined text-base text-secondary">info</span>
<span>Max Payload: 100MB (Local processing)</span>
</div>
</div>
</div>
<!-- Post-Analysis Evidentiary Actions Ribbon -->
<div id="downloadActionPanel" class="p-3 bg-surface-container border-t border-outline-variant/40 flex flex-wrap items-center justify-between gap-3 text-xs hidden">
  <div class="flex flex-wrap items-center gap-2">
    <a id="downloadVideoBtn" href="#" download class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-lowest hover:bg-surface-container-high text-on-surface border border-outline-variant font-semibold transition-colors">
      <span class="material-symbols-outlined text-sm text-primary">download</span>
      Download Processed Video (H.264)
    </a>
    <a id="downloadCsvBtn" href="#" download class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-lowest hover:bg-surface-container-high text-on-surface border border-outline-variant font-semibold transition-colors">
      <span class="material-symbols-outlined text-sm text-secondary">table_chart</span>
      Download Evidentiary Alerts CSV
    </a>
  </div>
  <div id="cachedIndicatorBanner" class="hidden items-center gap-1.5 text-amber-800 bg-amber-50 px-2.5 py-1 border border-amber-300 font-mono text-[11px]">
    <span class="material-symbols-outlined text-xs text-amber-600">verified</span>
    <span>Verified Telemetry SHA-256 Cache Hit</span>
  </div>
</div>
</div>
<!-- Telemetry Metric Ribbon (3 Key Metric Panels from Target Interface) -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
<!-- Tile 1: Headcount & Localized Packing -->
<div class="bg-surface-container-lowest border border-outline-variant p-4 flex flex-col justify-between shadow-sm">
<div class="flex items-start justify-between">
<div>
<span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant font-label block">Estimated Headcount</span>
